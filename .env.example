# Copy to .env (never commit .env)
# Supabase: Project Settings -> Database -> Connection string (use the "Session pooler" string if your network has no IPv6)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres
# "require" for Supabase, "disable" for a local Postgres / CI service container
DB_SSLMODE=require
SECRET_KEY=change-me

# Sprint 2 (optional; defaults shown)
IDLE_TIMEOUT_SECONDS=900
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Set to 1 once the app is served over HTTPS
SESSION_COOKIE_SECURE=0
